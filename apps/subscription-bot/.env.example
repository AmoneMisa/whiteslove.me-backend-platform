# Explicit opt-in keeps production safe until BotFather is configured.
TELEGRAM_SUBSCRIPTION_BOT_ENABLED=off

# Required when enabled: create the bot in @BotFather. The username is also used
# by the Nuxt /subscription-link route to open the correct bot from the website.
TELEGRAM_SUBSCRIPTION_BOT_TOKEN=
TELEGRAM_SUBSCRIPTION_BOT_USERNAME=

# Optional. If empty, the service reuses HIRING_DATABASE_URL from db.env.
SUBSCRIPTIONS_DATABASE_URL=
SUBSCRIPTIONS_DB_SCHEMA=subscriptions

SITE_BASE_URL=http://frontend:3000
SITE_PUBLIC_URL=https://whiteslove.me
FLAT_API_URL=http://flat-finder-backend:4000

# Polling interval for site subscriptions. Minimum enforced by code: 30 seconds.
SUBSCRIPTION_POLL_SECONDS=60
SUBSCRIPTION_MAX_NOTIFICATIONS_PER_SCAN=10
SUBSCRIPTION_FETCH_TIMEOUT_MS=20000
TELEGRAM_LONG_POLL_SECONDS=25

# ON = an OLX apartment is sent only after the flat-finder availability worker
# has persisted status=active. Telegram/Facebook/Threads have no equivalent
# source-level availability probe and therefore use the active flat feed state.
FLAT_REQUIRE_VERIFIED=on
