# Platform PostgreSQL. Production values must match the verified logical
# restore described in docs/DATABASE_VOLUME_MIGRATION.md.
POSTGRES_DB=whiteslove
POSTGRES_USER=whiteslove
POSTGRES_PASSWORD=replace-with-a-long-random-password
PLATFORM_DATABASE_URL=postgresql://whiteslove:replace-with-a-long-random-password@platform-postgres:5432/whiteslove

# Core feature flags
AI_ENABLED=true
AI_TEXT_ENABLED=true
AI_VISION_ENABLED=true

# Shared internal API key. Generate with: openssl rand -hex 32
AI_API_KEY=replace-with-a-long-random-key

# Default provider gateway. Production routes both text and vision exclusively
# through the self-hosted FreeLLMAPI container.
TEXT_PROVIDERS=freellmapi
VISION_PROVIDERS=freellmapi
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TEXT_MODEL=auto:balanced
FREELLMAPI_VISION_MODEL=auto:smart

# Optional local-development override only. Production FreeLLMAPI exports its
# generated unified freellmapi-* key into the shared volume before healthcheck,
# so there is nothing to copy from the dashboard.
FREELLMAPI_API_KEY=

# Leave blank on the server: deploy.sh generates this once, writes it to .env,
# and preserves it across future deploys. Never rotate it without migrating the
# persisted FreeLLMAPI database because provider keys are encrypted with it.
FREELLMAPI_ENCRYPTION_KEY=
# Production is pinned by docker-compose.yml; override deliberately when testing
# a newer compatible release.
FREELLMAPI_IMAGE=ghcr.io/tashfeenahmed/freellmapi:v0.9.0

AI_TEXT_TIMEOUT_MS=120000
VISION_CONCURRENCY=1
VISION_PROVIDER_TIMEOUT_MS=30000
VISION_COOLDOWN_MS=300000
VISION_CACHE_TTL_MS=2592000000

# Existing free-tier credentials. docker-compose imports every non-empty value
# below into FreeLLMAPI declaratively on each boot; no dashboard copy/paste is
# required. Missing values stay disabled. FreeLLMAPI then routes only through
# its free catalog; ai-worker itself does not receive these secrets in the
# production Compose service.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=
GEMINI_API_KEY=
# Gemini blocks some regions ("User location is not supported for the API
# use"). If that hits this deployment's egress IP, point this at a
# same-protocol reverse-proxy relay run on a server Google does serve
# instead (proxy_pass to generativelanguage.googleapis.com, preserving
# path/headers/body) - no other change needed. Leave blank to use Google's
# endpoint directly.
GEMINI_BASE_URL=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEXT_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
HUGGINGFACE_TEXT_MODEL=
LLM7_API_KEY=
LLM7_VISION_MODEL=gpt-5.4-mini
LLM7_TEXT_MODEL=gpt-oss
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TEXT_MODEL=
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-small-latest
MISTRAL_TEXT_MODEL=mistral-small-latest
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# Bounded in-process executor. Durable caller state remains in flat-finder/Postgres
# and Personal-Site's persistent state volume; ai-worker itself is restart-safe.
AI_CONCURRENCY=1
AI_QUEUE_MAX_PENDING=100
AI_MAX_RETRIES=1
AI_MIN_CONFIDENCE=0.6
AI_MAX_TEXT_CHARS=32000
# Ten photos gives vision enough coverage for kitchen/bathrooms/rooms/outdoor
# areas while keeping one listing request bounded. URL duplicates are removed
# by Flat Finder before submission.
AI_MAX_PHOTOS_PER_LISTING=10

# Bounded process-local LRU/TTL cache. Prompt/schema versions are part of cache
# keys; bump them whenever the corresponding contracts change.
PROMPT_VERSION=2
SCHEMA_VERSION=4
AI_CACHE_MAX_ENTRIES=2000
AI_CACHE_TTL_MS=86400000
AI_TRANSLATION_CACHE_TTL_MS=604800000

# Docker resource limits for the ai-worker container itself.
AI_WORKER_CPUS=0.5
AI_WORKER_MEMORY_LIMIT=1g

# Self-hosted FreeLLMAPI resource limits / host-only dashboard port.
FREELLMAPI_HOST_PORT=3001
FREELLMAPI_CPUS=0.5
FREELLMAPI_MEMORY_LIMIT=768m

# Telegram Bot API subscription delivery. Keep disabled until the token and
# website BFF URL are configured.
TELEGRAM_SUBSCRIPTION_BOT_ENABLED=off
TELEGRAM_SUBSCRIPTION_BOT_TOKEN=
TELEGRAM_SUBSCRIPTION_BOT_USERNAME=
SITE_PUBLIC_URL=https://whiteslove.me
SITE_INTERNAL_URL=https://whiteslove.me
SUBSCRIPTIONS_DB_SCHEMA=subscriptions
SUBSCRIPTION_POLL_SECONDS=60
SUBSCRIPTION_MAX_NOTIFICATIONS_PER_SCAN=10
SUBSCRIPTION_FETCH_TIMEOUT_MS=20000
TELEGRAM_LONG_POLL_SECONDS=25
FLAT_REQUIRE_VERIFIED=on
SUBSCRIPTION_BOT_MEMORY_LIMIT=256m
SUBSCRIPTION_BOT_CPUS=0.5
